# Token from a remotely-managed Cloudflare Tunnel.
# Never commit the real token.
CLOUDFLARE_TUNNEL_TOKEN=

# GreptimeDB must be reachable from the agent-telemetry container.
# Example when GreptimeDB is on another private host:
ATEL_GREPTIME_ENDPOINT=http://10.0.0.10:4000
ATEL_GREPTIME_DATABASE=public
